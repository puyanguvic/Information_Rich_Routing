set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.30.21.1/30
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.30.22.1/30
set / interface ethernet-1/10 admin-state enable
set / interface ethernet-1/10 subinterface 0 admin-state enable
set / interface ethernet-1/10 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/10 subinterface 0 ipv4 address 10.30.2.1/24
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default interface ethernet-1/10.0
set / network-instance default next-hop-groups group l1_ecmp admin-state enable
set / network-instance default next-hop-groups group l1_ecmp nexthop 1 ip-address 10.30.21.2
set / network-instance default next-hop-groups group l1_ecmp nexthop 2 ip-address 10.30.22.2
set / network-instance default next-hop-groups group l1_via_s1 admin-state enable
set / network-instance default next-hop-groups group l1_via_s1 nexthop 1 ip-address 10.30.21.2
set / network-instance default next-hop-groups group l1_via_s2 admin-state enable
set / network-instance default next-hop-groups group l1_via_s2 nexthop 1 ip-address 10.30.22.2
set / network-instance default static-routes route 10.30.1.0/24 admin-state enable
set / network-instance default static-routes route 10.30.1.0/24 metric 1
set / network-instance default static-routes route 10.30.1.0/24 preference 5
set / network-instance default static-routes route 10.30.1.0/24 next-hop-group l1_ecmp
